# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3000
NODE_ENV=development

# Local data store
# Default: backend/data/local-db.json
# On Render, point this at a persistent disk path if you attach one.
LOCAL_DB_PATH=

# Local AI Engine via Ollama (Optional)
# If Ollama is not installed/running, the app will automatically use a safe offline assistant fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=60000
OLLAMA_TEMPERATURE=0.4
OLLAMA_MAX_TOKENS=450
REQUIRE_CLINICIAN_REVIEW=true
